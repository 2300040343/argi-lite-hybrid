{
  "name": "agrilite-offline",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "lint": "eslint .",
    "prepare-config": "node scripts/prepare-config.cjs",
    "prestart": "npm run prepare-config",
    "preandroid": "npm run prepare-config",
    "start": "react-native start",
    "pretest": "npm run prepare-config",
    "test": "jest",
    "pretypecheck": "npm run prepare-config",
    "typecheck": "tsc --noEmit",
    "prebundle": "npm run prepare-config",
    "bundle": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "apk:pilot": "npm run prepare-config && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.84.1",
    "llama.rn": "0.12.0",
    "react-native-fs": "2.20.0",
    "react-native-image-picker": "8.3.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}